# Copy to .env.local and fill in.

# Server the app talks to (no trailing slash).
#   local dev : http://<PC의 LAN IP>:3000   (휴대폰과 같은 Wi-Fi)
#   test 서버 : https://<test 서버 주소>
#   main 서버 : https://<main 서버 주소>
EXPO_PUBLIC_API_URL=http://192.168.0.18:3000

# 1 = 서버 없이 예시 데이터로 화면만 확인 (웹 미리보기용)
EXPO_PUBLIC_DEMO=0

# Google 로그인 (선택). 서버의 GOOGLE_CLIENT_ID(웹 클라이언트)와 같은 값을 넣어야
# 서버가 ID 토큰을 검증할 수 있어요.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS 클라이언트의 역방향 ID (com.googleusercontent.apps.xxxx). 설정하면 Google 로그인 플러그인이 켜져요.
GOOGLE_IOS_URL_SCHEME=
