generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  employeeId    String?       @unique
  status        String        @default("ACTIVE")
  isOperator    Boolean       @default(false)
  signupVerifiedAt DateTime?
  pendingInviteCode String?
  pendingInviteAutoApprove Boolean @default(false)
  accounts      Account[]
  sessions      Session[]
  groupMembers  GroupMember[]
  ownedGroups   Group[]       @relation("GroupLeader")
  events        Event[]
  pushSubscriptions PushSubscription[]
  mobileDeviceTokens MobileDeviceToken[]
  qrInviteTokens QrInviteToken[]
  dayNotesCreated GroupDayNote[] @relation("GroupDayNoteCreatedBy")
  dayNotesUpdated GroupDayNote[] @relation("GroupDayNoteUpdatedBy")
  personalDayNotes PersonalDayNote[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model NotificationSchedule {
  id        String   @id @default(cuid())
  groupId   String
  message   String
  dayOfWeek String   // "1,3,5" (0=일,1=월,...,6=토)
  timeHour  Int      // 0-23
  timeMin   Int      // 0-59
  active    Boolean  @default(true)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model MobileDeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("ANDROID")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Group {
  id              String        @id @default(cuid())
  name            String
  description     String?
  inviteCode      String        @unique @default(cuid())
  trackerOptions  String?
  laptopOptions   String?
  // JSON: [{ id, name, items: string[] }]. Null = not set yet; read trackerOptions/laptopOptions as two categories.
  equipmentCategories String?
  targetCount     Int           @default(2)
  eventDisplayLimit Int         @default(3)
  // GitLab calendar upload (30-minute auto upload and the manual button). Off = this group is skipped.
  calendarSyncEnabled Boolean   @default(true)
  leaderId        String
  leader      User          @relation("GroupLeader", fields: [leaderId], references: [id])
  members     GroupMember[]
  events      Event[]
  notifications Notification[]
  schedules   NotificationSchedule[]
  qrInviteTokens QrInviteToken[]
  dayNotes    GroupDayNote[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Notification {
  id            String   @id @default(cuid())
  groupId       String
  type          String
  actorUserId   String?
  eventId       String?
  groupMemberId String?
  targetDate    String?
  sourceKey     String   @unique
  title         String
  body          String
  readAt        DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([type, resolvedAt])
}

model QrInviteToken {
  id          String   @id @default(cuid())
  token       String   @unique
  groupId      String
  createdById  String
  expiresAt    DateTime
  // Short heartbeat lease: closing/hiding the issuing window revokes the code.
  leaseUntil   DateTime?
  revokedAt    DateTime?
  // Valid for exactly one minute while the issuing window is open. Elevated issuers
  // skip group approval for active accounts; new accounts always require operator approval.
  autoApprove  Boolean  @default(false)
  // Signed-in users may reserve the code while entering a nickname, within its lifetime.
  // claimSecret remains for legacy anonymous claims only.
  claimedById  String?
  claimSecret  String?  @unique
  claimedAt    DateTime?
  // Spent: the membership (or the new account's pending invite) was created.
  usedAt       DateTime?
  createdAt    DateTime @default(now())
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

// Durable signup quotas. Keys hold HMAC digests, never raw IPs/device IDs.
model SignupQuota {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model CustomHoliday {
  id        String   @id @default(cuid())
  date      String   @unique // "yyyy-MM-dd" — 전체 그룹에 공통 적용
  name      String
  type      String   // "holiday" (평일→휴일) | "workday" (휴일→평일)
  createdAt DateTime @default(now())
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  nickname  String?
  role      String   @default("MEMBER")
  status    String   @default("ACTIVE")
  canNotify Boolean  @default(false)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
}

model Event {
  id          String   @id @default(cuid())
  category    String   @default("BUSINESS_TRIP")
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean  @default(false)
  color       String   @default("#3B82F6")
  overtimeAvailable Boolean  @default(false)
  isOvertimeOnly    Boolean  @default(false)
  overtimeKey       String?  @unique
  equipmentOnly     Boolean  @default(false)
  personnel         String?
  equipment         String?
  creatorId         String
  groupId           String?
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GroupDayNote {
  id          String   @id @default(cuid())
  groupId      String
  date        String
  content     String
  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("GroupDayNoteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedBy   User     @relation("GroupDayNoteUpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)

  @@unique([groupId, date])
  @@index([groupId, date])
}

model PersonalDayNote {
  id        String   @id @default(cuid())
  userId    String
  date      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// One row per AI quick-add request that reached OpenRouter (POST /api/events/parse).
// No relation to User on purpose: cost history stays after a user is deleted.
model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  feature      String   @default("quick_add")
  model        String
  // "ok", or the failure reason (timeout, upstream, bad_output, rate_limited)
  status       String   @default("ok")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  // USD. OpenRouter's reported cost when it gives one; otherwise tokens × lib/aiUsage.ts prices.
  cost         Float    @default(0)
  costSource   String   @default("openrouter")
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Per-user override of the monthly AI call cap (Seoul calendar month). No row → the default cap.
model AiUsageLimit {
  userId       String   @id
  monthlyLimit Int
  updatedById  String?
  updatedAt    DateTime @updatedAt
}
