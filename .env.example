# Web app
DATABASE_URL=file:/app/data/prod.db
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
OPERATOR_EMAIL=operator@example.com

# MCP internal REST authentication. MCP_SERVICE_USER_EMAIL must be an existing
# app user with the appropriate operator/group permissions.
MCP_API_TOKEN=replace-with-a-32-byte-or-longer-random-token
MCP_SERVICE_USER_EMAIL=operator@example.com
